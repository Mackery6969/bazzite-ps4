# Bazzite for PS4 Linux (Aeolia/Belize/Baikal)
#
# Layered on top of the published bazzite-deck image (KDE Plasma + Game Mode)
# instead of rebuilding the whole Bazzite stack, so syncing with upstream only
# means rebuilding this file. See PS4.md for how the result boots on a PS4.

ARG BASE_IMAGE="${BASE_IMAGE:-ghcr.io/ublue-os/bazzite-deck:stable}"

FROM scratch AS ctx
COPY build_files /

# Headless PS4 fan control (talks to the ICC through /dev/icc)
FROM registry.fedoraproject.org/fedora:44 AS ps4fancontrol
RUN dnf5 -y install gcc git && \
    git clone https://github.com/JKeyRandom/ps4fancontrol.git /src && \
    git -C /src checkout 643f7b86886f1819ec2ab5a2fc46b71b3366ac79 && \
    sed -i \
        -e 's|/userdata/system/.config/ps4fancontrol|/var/lib/ps4fancontrol|g' \
        -e 's|"/userdata/system/.config"|"/var/lib"|g' \
        /src/ps4fancontrol.c && \
    gcc -O2 -o /ps4fancontrol /src/ps4fancontrol.c

FROM ${BASE_IMAGE} AS bazzite-ps4

ARG IMAGE_NAME="${IMAGE_NAME:-bazzite-ps4}"
ARG IMAGE_VENDOR="${IMAGE_VENDOR:-mackery6969}"
ARG IMAGE_TAG="${IMAGE_TAG:-stable}"
ARG PS4_MESA_REPO="${PS4_MESA_REPO:-mackery6969/bazzite-ps4}"
# Only for local test builds before a Mesa release exists; the result has no PS4 GPU support
ARG PS4_SKIP_MESA="${PS4_SKIP_MESA:-}"

COPY system_files/ps4/ /
COPY --from=ps4fancontrol /ps4fancontrol /usr/bin/ps4fancontrol

# Swap Mesa (x86_64 + i686) for the Liverpool/Gladius patched build of the
# exact same Terra version, published as a release by build_ps4_mesa.yml
RUN --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/cache/libdnf5 \
    --mount=type=cache,dst=/var/log \
    --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=tmpfs,dst=/tmp \
    if [[ -n "${PS4_SKIP_MESA}" ]]; then echo "Skipping PS4 Mesa (test build)"; exit 0; fi && \
    mesa_ver="$(rpm -q --queryformat '%{VERSION}' mesa-dri-drivers.x86_64)" && \
    mesa_rel="$(rpm -q --queryformat '%{RELEASE}' mesa-dri-drivers.x86_64)" && \
    ps4_rel="${mesa_rel%.fc*}.ps4.fc${mesa_rel##*.fc}" && \
    tag="mesa-${mesa_ver}-${ps4_rel}" && \
    mapfile -t mesa_pkgs < <(rpm -qa --queryformat '%{NAME} %{ARCH}\n' 'mesa-*' | sort -u) && \
    mkdir -p /tmp/mesa && \
    for pkg in "${mesa_pkgs[@]}"; do \
        read -r name arch <<< "${pkg}" && \
        file="${name}-${mesa_ver}-${ps4_rel}.${arch}.rpm" && \
        curl -fsSL --retry 3 -o "/tmp/mesa/${file}" \
            "https://github.com/${PS4_MESA_REPO}/releases/download/${tag}/${file}" || \
            { echo "Release ${tag} has no ${file}; run the 'Build PS4 Mesa' workflow for this Terra version" >&2; exit 1; }; \
    done && \
    dnf5 versionlock delete 'mesa-*' && \
    dnf5 -y upgrade /tmp/mesa/*.rpm && \
    for pkg in "${mesa_pkgs[@]}"; do \
        read -r name arch <<< "${pkg}" && \
        rpm -q --queryformat '%{RELEASE}\n' "${name}.${arch}" | grep -q '\.ps4' || \
            { echo "${name}.${arch} was not replaced by the PS4 build" >&2; exit 1; }; \
    done && \
    dnf5 versionlock add $(rpm -qa --queryformat '%{NAME}\n' 'mesa-*' | sort -u) && \
    unset -v mesa_ver mesa_rel ps4_rel tag mesa_pkgs pkg name arch file && \
    /ctx/cleanup

# PS4 hardware support and boot glue
RUN --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/cache/libdnf5 \
    --mount=type=cache,dst=/var/log \
    --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=tmpfs,dst=/tmp \
    dnf5 -y install busybox && \
    printf '%s\n' \
        '9920,	00,	AMD Liverpool (PlayStation 4)' \
        '9922,	00,	AMD Liverpool (PlayStation 4)' \
        '9923,	00,	AMD Liverpool (PlayStation 4)' \
        '9924,	11,	AMD Gladius (PlayStation 4 Pro)' \
        >> /usr/share/libdrm/amdgpu.ids && \
    sed -i 's/^default=.*/default=performance/' /etc/tuned/ppd.conf && \
    grep -q '^default=performance$' /etc/tuned/ppd.conf && \
    echo "throughput-performance-bazzite" > /etc/tuned/active_profile && \
    echo "manual" > /etc/tuned/profile_mode && \
    jq --arg name "${IMAGE_NAME}" \
       --arg vendor "${IMAGE_VENDOR}" \
       --arg ref "ostree-unverified-registry:ghcr.io/${IMAGE_VENDOR}/${IMAGE_NAME}" \
       --arg tag "${IMAGE_TAG}" \
       '."image-name" = $name | ."image-vendor" = $vendor | ."image-ref" = $ref | ."image-tag" = $tag' \
       /usr/share/ublue-os/image-info.json > /tmp/image-info.json && \
    mv /tmp/image-info.json /usr/share/ublue-os/image-info.json && \
    for unit in \
        greenboot-grub2-set-counter.service \
        greenboot-grub2-set-success.service \
        greenboot-rpm-ostree-grub2-check-fallback.service \
        greenboot-healthcheck.service \
        redboot-auto-reboot.service \
        bootloader-update.service \
        bootupd.socket; \
    do \
        systemctl disable "${unit}" 2>/dev/null || true; \
    done && unset -v unit && \
    systemctl enable bazzite-ps4-firstboot.service && \
    systemctl enable bazzite-ps4-sync-init.service && \
    systemctl enable ps4fc.service && \
    /ctx/cleanup

RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    /ctx/finalize

RUN --mount=type=tmpfs,target=/run --network=none bootc container lint
